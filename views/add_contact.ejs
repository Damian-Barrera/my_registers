<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/estilos/main.css" />
    <link rel="stylesheet" href="/estilos/dashboard.css" />
    <link rel="stylesheet" href="/estilos/edit.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />

    <title>Document</title>
  </head>
  <body>
    <div class="main">
      <nav>
        <header class="header">
          <i class="fa-solid fa-users"></i>
          <h3>
            <a href="/panel">Panel de Control</a>
          </h3>
        </header>
        <hr />
        <ul>
          <li>
            <a href="/dashboard">
              <i class="fa-solid fa-users"></i>
              <span>Ver Contactos</span>
            </a>
          </li>
          <li>
            <a href="/add_contact">
              <i class="fa-solid fa-user-plus"></i>
              <span>Agregar Contacto</span>
            </a>
          </li>
        </ul>

        <footer>
          <i class="fa-regular fa-user"></i>
          <div class="logout">
            <p>Cerrar Sesión</p>
            <span><%= user.email %></span>
          </div>
          <a href="/logout">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
          </a>
        </footer>
      </nav>
      <section class="main-content">
        <header>
          <section class="profile-header">
            <a href="/profile">
              <i class="fa-solid fa-arrow-left"></i>
              Atras
            </a>
            <h2>Nuevo Contacto</h2>
          </section>
        </header>
        <form
          class="form-edit"
          action="/add_contact"
          method="POST"
          enctype="multipart/form-data"
        >
          <label for="">Nombre:</label>
          <input type="text" name="nombre" id="" />

          <label for="">Apellido:</label>
          <input type="text" name="apellido" id="" />

          <label for="">Direccion:</label>
          <input type="text" name="direccion" id="" />

          <label for="">Telefono:</label>
          <input type="tel" name="telefono" id="" />

          <label for="">Zona:</label>
          <input type="text" name="zona" id="" />

          <label for="">Edad:</label>
          <input type="text" name="edad" id="" />

          <label for="">Medidas:</label>
          <input type="text" name="medidas" id="" />

          <label for="">Altura:</label>
          <input type="text" name="altura" id="" />

          <label for="">Horarios:</label>
          <input type="text" name="horarios" id="" />

          <label for="">Tarifa:</label>
          <input type="text" name="tarifa" id="" />

          <label for="">Descripción:</label>
          <textarea name="descripcion" id=""></textarea>

          <section class="add-images">
            <h3 for="">Agregar Imagenes</h3>
            <div class="cargar-archivo">
              <input type="file" name="fotos" multiple id="" />
              <p>+</p>
              <p>Click para agreagar mas imagenes</p>
            </div>
            <div class="nuevas-imgs" id="nuevas-imgs"></div>
          </section>
          <section class="btns">
            <button type="button" class="cancel">
              <a href="/profile">Cancelar</a>
            </button>
            <button type="submit" class="guardar">Guardar</button>
          </section>
        </form>
      </section>
    </div>
    <script>
      const input = document.querySelector('.add-images input[type="file"]');
      const nuevasImgs = document.getElementById("nuevas-imgs");

      let archivos = []; // acá guardamos los File reales que van a viajar en el submit

      function actualizarInput() {
        const dataTransfer = new DataTransfer();
        archivos.forEach((file) => dataTransfer.items.add(file));
        input.files = dataTransfer.files;
      }

      input.addEventListener("change", () => {
        const nuevosArchivos = Array.from(input.files);

        nuevosArchivos.forEach((file) => {
          const reader = new FileReader();

          reader.onload = (e) => {
            archivos.push(file);

            const card = document.createElement("div");
            card.classList.add("card-nueva");

            card.innerHTML = `
          <img src="${e.target.result}" alt="${file.name}" />
          <button type="button" class="delete-nueva">✕</button>
        `;

            card
              .querySelector(".delete-nueva")
              .addEventListener("click", () => {
                archivos = archivos.filter((f) => f !== file);
                card.remove();
                actualizarInput();
              });

            nuevasImgs.appendChild(card);
            actualizarInput(); // sincronizamos el input real cada vez que agregamos una
          };

          reader.readAsDataURL(file);
        });
      });
    </script>
  </body>
</html>
