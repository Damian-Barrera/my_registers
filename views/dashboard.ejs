<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/estilos/main.css" />
    <link rel="stylesheet" href="/estilos/dashboard.css" />

    <title>Dashboard</title>
  </head>
  <body>
    <div class="main">
     <%- include("partials/nav") %>
      <section class="main-content">
        <header>
          <h2>Directorio</h2>
          <form class="search">
            <label for="buscar">
              <i class="fa-solid fa-magnifying-glass"></i>
            </label>
            <input type="search" name="" id="buscar" placeholder="Buscar por nombre" />
          </form>
        </header>

        <div class="cards-images">
          <% chicas.forEach(chica => {%>
          <div class="img">
            <a href="/profile/<%= chica.slug %>">
              <% if (chica.ruta) { %>
                <img src="<%= chica.ruta %>" alt="<%= chica.nombre %>" />
              <% } else { %>
                <img src="/imgs/default.jpeg" alt="<%= chica.nombre %>" />
              <% } %>
              <span class="name-model"><%=chica.nombre%> </span>
            </a>
          </div>
          <% }) %>
          
        </div>
      </section>
    </div>
    <script>
     
          const buscador = document.getElementById("buscar");
          const tarjetas = document.querySelectorAll(".cards-images .img");

            buscador.addEventListener("input", () => {
               const texto = buscador.value
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");

              tarjetas.forEach((tarjeta) => {
                const nombre = tarjeta
                  .querySelector(".name-model")
                  .textContent
                  .toLowerCase()
                  .normalize("NFD")
                  .replace(/[\u0300-\u036f]/g, "");

                tarjeta.style.display = nombre.includes(texto) ? "" : "none";
              });
            });
        
    </script>
  </body>
</html>


